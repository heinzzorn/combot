TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional. Only needed if 212-bot isn't checked out as a sibling directory
# (../212-bot relative to this repo) -- e.g. because it hasn't yet migrated
# to bot-deployer's managed /var/lib/bot-deployer/apps/ layout.
# BOT212_DIR=/path/to/212-bot

# Optional, same idea, for the bot-deployer checkout combot shells out to
# for /deploy.
# BOT_DEPLOYER_DIR=/path/to/bot-deployer
